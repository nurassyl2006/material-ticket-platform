{
  "name": "material-ticket-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://nurassyl2006.github.io/material-ticket-platform",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"node --watch server/index.js\" \"vite\"",
    "server": "node --watch server/index.js",
    "server:prod": "node server/index.js",
    "client": "vite",
    "db:view": "node server/view-db.js",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:server": "npm run build && rsync -avz --delete dist/ service@10.1.13.50:~/material-ticket-platform/dist/",
    "update:server": "ssh -t service@10.1.13.50 \"cd ~/material-ticket-platform && git fetch origin main && git reset --hard origin/main && npm install && npm run build && (pm2 restart all 2>/dev/null || (pkill -f 'node.*server/index.js' || true && nohup node server/index.js > ~/server.log 2>&1 &))\"",
    "autoupdate:install": "ssh -t service@10.1.13.50 \"cd ~/material-ticket-platform && git fetch origin main && git reset --hard origin/main && bash scripts/install-autoupdate-cron.sh\"",
    "autoupdate:logs": "ssh -t service@10.1.13.50 \"tail -n 50 -f ~/autoupdate.log\"",
    "autoupdate:run": "ssh -t service@10.1.13.50 \"bash ~/material-ticket-platform/scripts/autoupdate.sh\"",
    "tunnel": "node server/tunnel.js",
    "library:server": "node library-system/server/index.js",
    "library:dev": "concurrently -n \"LIB_SRV,LIB_UI\" -c \"magenta,cyan\" \"node --watch library-system/server/index.js\" \"vite library-system --port 5174\"",
    "library:build": "vite build library-system",
    "library:app": "google-chrome --app=http://localhost:5002 || chromium --app=http://localhost:5002 || firefox http://localhost:5002",
    "library:status": "systemctl --user status athenaeum-library --no-pager 2>/dev/null || curl -s http://localhost:5002/api/health",
    "library:restart": "systemctl --user restart athenaeum-library 2>/dev/null || npm run library:server",
    "library:logs": "journalctl --user -u athenaeum-library -f",
    "library:service:install": "bash scripts/install-library-service.sh",
    "library:keepalive": "bash scripts/keepalive-library.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
